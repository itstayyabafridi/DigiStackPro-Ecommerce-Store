# Supabase transaction pooler for runtime; direct or session connection for migrations.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only random secret (32+ characters) for password/verification session grants.
ADMIN_SESSION_SECRET=""
RESEND_API_KEY=""
RESEND_FROM="DigistackPro <orders@your-verified-domain.com>"
ROOT_DOMAIN="digistackpro.store"
ADMIN_HOST="admin.digistackpro.store"
# Leave empty before connecting the domain. Vercel/request origin is used instead.
SITE_URL=""
# Optional seed upload: true uploads the included sample text downloads.
SEED_UPLOAD_FILES="false"
