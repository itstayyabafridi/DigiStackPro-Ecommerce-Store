generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  approved
  rejected
}

enum FunnelStatus {
  draft
  published
}

enum StepType {
  landing
  checkout
  order_bump
  upsell
  downsell
  thank_you
}

enum EventType {
  view
  accept
  decline
  purchase
}

model Customer {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String   @default("")
  role      Role     @default(customer)
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customers")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  slug         String       @unique
  description  String
  price        Int
  thumbnailUrl String       @map("thumbnail_url")
  filePath     String       @map("file_path")
  categoryId   String?      @map("category_id") @db.Uuid
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isPublished  Boolean      @default(false) @map("is_published")
  isFeatured   Boolean      @default(false) @map("is_featured")
  archived     Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")
  items        OrderItem[]
  steps        FunnelStep[]

  @@index([isPublished, archived])
  @@map("products")
}

model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  customerId           String?        @map("customer_id") @db.Uuid
  customer             Customer?      @relation(fields: [customerId], references: [id])
  name                 String
  email                String
  whatsapp             String
  status               OrderStatus    @default(pending)
  subtotal             Int
  discount             Int            @default(0)
  total                Int
  paymentMethod        String         @map("payment_method")
  paymentScreenshotUrl String?        @map("payment_screenshot_url")
  paymentSubmittedAt   DateTime?      @map("payment_submitted_at")
  adminNote            String?        @map("admin_note")
  checkoutTokenHash    String         @unique @map("checkout_token_hash")
  couponId             String?        @map("coupon_id") @db.Uuid
  coupon               Coupon?        @relation(fields: [couponId], references: [id])
  deliverySentAt       DateTime?      @map("delivery_sent_at")
  deliveryError        String?        @map("delivery_error")
  deliveryLeaseAt      DateTime?      @map("delivery_lease_at")
  deliveryVersion      Int            @default(1) @map("delivery_version")
  deliveryPayload      Json?          @map("delivery_payload")
  deliveryAttemptAt    DateTime?      @map("delivery_attempt_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  items                OrderItem[]
  funnelSession        FunnelSession?

  @@index([email, status])
  @@index([status, paymentSubmittedAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  title     String
  price     Int
  filePath  String  @map("file_path")

  @@unique([orderId, productId])
  @@map("order_items")
}

model Coupon {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  kind      String
  value     Int
  minimum   Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  limit     Int?
  orders    Order[]

  @@map("coupons")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

model Funnel {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  slug      String          @unique
  status    FunnelStatus    @default(draft)
  revision  Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at")
  steps     FunnelStep[]
  sessions  FunnelSession[]

  @@map("funnels")
}

model FunnelStep {
  id               String          @id @default(uuid()) @db.Uuid
  funnelId         String          @map("funnel_id") @db.Uuid
  funnel           Funnel          @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  position         Int
  archived         Boolean         @default(false)
  type             StepType
  config           Json
  productId        String?         @map("product_id") @db.Uuid
  product          Product?        @relation(fields: [productId], references: [id])
  nextOnAccept     String?         @map("next_on_accept") @db.Uuid
  nextOnDecline    String?         @map("next_on_decline") @db.Uuid
  events           FunnelEvent[]
  checkoutSessions FunnelSession[] @relation("CheckoutStep")

  @@index([funnelId, position])
  @@map("funnel_steps")
}

model FunnelSession {
  id                 String        @id @default(uuid()) @db.Uuid
  tokenHash          String        @unique @map("token_hash")
  funnelId           String        @map("funnel_id") @db.Uuid
  funnel             Funnel        @relation(fields: [funnelId], references: [id])
  revision           Int
  currentStepId      String?       @map("current_step_id") @db.Uuid
  checkoutStepId     String?       @map("checkout_step_id") @db.Uuid
  checkoutStep       FunnelStep?   @relation("CheckoutStep", fields: [checkoutStepId], references: [id], onDelete: Restrict)
  selectedProductIds String[]      @default([]) @map("selected_product_ids")
  orderId            String?       @unique @map("order_id") @db.Uuid
  order              Order?        @relation(fields: [orderId], references: [id])
  expiresAt          DateTime      @map("expires_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  events             FunnelEvent[]

  @@map("funnel_sessions")
}

model FunnelEvent {
  id        String        @id @default(uuid()) @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  session   FunnelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepId    String        @map("step_id") @db.Uuid
  step      FunnelStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  type      EventType
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([sessionId, stepId, type])
  @@map("funnel_events")
}
